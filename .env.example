# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/filings

# Required by SEC EDGAR: your name and a contact email
SEC_USER_AGENT="Your Name you@example.com"

# Which model answers: anthropic | ollama | vllm
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# Embeddings (keep the same for ingestion and serving)
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

RETRIEVAL_MODE=hybrid_rerank
RERANK_ENABLED=true

# Public demo guard rails
RATE_LIMIT_PER_MINUTE=8
DAILY_QUESTION_CAP=300
# Proxies in front of the app that append to X-Forwarded-For (Render = 1, local = 0)
TRUSTED_PROXY_HOPS=1
